# Nextflow 執行過程產生的暫存檔（不需上傳）
work/
.nextflow/
.nextflow.log*

# 保留空目錄，忽略實際 Slurm 日誌
logs/*
!logs/.gitkeep
!logs/gut-to-soil/
logs/gut-to-soil/*
!logs/gut-to-soil/.gitkeep

# 依 clone 位置產生，內含目前使用者的 FASTQ 絕對路徑
01_data/samplesheet.tsv
examples/gut-to-soil/data/samplesheet.tsv

# 分析結果（學生執行後自動產生）
results/

# 系統檔案
.DS_Store
*.swp
*.swo
__pycache__/
*.py[cod]
Rplots.pdf

# 大型資料與暫存檔
01_data/fastq/
01_data/metadata.raw.tsv
examples/gut-to-soil/data/fastq/*
!examples/gut-to-soil/data/fastq/.gitkeep
examples/gut-to-soil/data/metadata.raw.tsv
